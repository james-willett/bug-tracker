pipeline {
    agent any

    stages {
        stage('Unit Tests Backend') {
            agent {
                docker {
                    image 'golang:1.21-alpine'
                    args '-u root'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-backend') {
                    sh '''
                        apk add --no-cache git
                        GOCACHE=/tmp/go-build-cache go install github.com/jstemmer/go-junit-report@latest
                        GOPATH_BIN=$(go env GOPATH)/bin
                        GOCACHE=/tmp/go-build-cache go test ./... -v 2>&1 | ${GOPATH_BIN}/go-junit-report > test-results.xml || true
                    '''
                }
            }
        }

        stage('Unit Tests Frontend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh """
                        npm ci
                        npm run test
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                def testResults = []
                if (fileExists('bugtracker-backend/test-results.xml')) {
                    testResults.add('bugtracker-backend/test-results.xml')
                }
                if (fileExists('bugtracker-frontend/test-results.xml')) {
                    testResults.add('bugtracker-frontend/test-results.xml')
                }
                if (testResults.size() > 0) {
                    junit testResults.join(',')
                }
            }
        }
    }
}