pipeline {
    agent any

    stages {
        stage('Execute Unit Tests') {
            parallel {

                stage('Unit tests backend') {
                    agent {
                        docker {
                            image 'snakee/golang-junit:1.21'
                            args '-u 1000:1000'
                        }
                    }

                    steps {
                        dir('bugtracker-backend') {
                            sh '''
                                set -o pipefail

                                mkdir -p .cache/go-build
                                mkdir -p .cache/go-mod
                                mkdir -p reports

                                export GOCACHE="$PWD/.cache/go-build"
                                export GOMODCACHE="$PWD/.cache/go-mod"

                                go test -v -coverprofile=coverage.out ./... \
                                    2>&1 | go-junit-report > test-results.xml

                                go tool cover \
                                    -html=coverage.out \
                                    -o reports/coverage.html
                            '''
                        }
                    }

                    post {
                        always {
                            junit(
                                testResults: 'bugtracker-backend/test-results.xml',
                                allowEmptyResults: true
                            )

                            publishHTML(
                                target: [
                                    reportDir: 'bugtracker-backend/reports',
                                    reportFiles: 'coverage.html',
                                    reportName: 'Backend Coverage Report',
                                    allowMissing: true,
                                    keepAll: true,
                                    alwaysLinkToLastBuild: true
                                ]
                            )
                        }
                    }
                }

                stage('Unit tests frontend') {
                    agent {
                        docker {
                            image 'node:20-alpine'
                        }
                    }

                    steps {
                        dir('bugtracker-frontend') {
                            sh '''
                                npm ci

                                npm test -- --runInBand --watchAll=false

                                mkdir -p reports
                                mv coverage reports/
                            '''
                        }
                    }

                    post {
                        always {
                            junit(
                                testResults: 'bugtracker-frontend/test-results.xml',
                                allowEmptyResults: true
                            )

                            publishHTML(
                                target: [
                                    reportDir: 'bugtracker-frontend/reports/coverage',
                                    reportFiles: 'index.html',
                                    reportName: 'Frontend Coverage Report',
                                    allowMissing: true,
                                    keepAll: true,
                                    alwaysLinkToLastBuild: true
                                ]
                            )
                        }
                    }
                }
            }
        }
        stage ("Launch Application"){
                agent{
                    docker{
                        image 'docker:27.5.1'
                        reuseNode true
                        args "-v /var/run/docker.sock:/var/run/docker.sock -u 0"

                    }
                }

                steps{
                    sh '''
                        docker-compose up --build -d
                    '''
                }
            }
        
    }

    post {
        always {
            cleanWs()
        }
    }
}
