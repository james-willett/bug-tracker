pipeline {
    agent any

    stages {
        stage('Unit Tests Backend') {
            agent {
                docker {
                    image 'golang:1.21-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-backend') {
                   sh 'GOCACHE=/tmp/go-build-cache go test ./... -v'
                }
            }
        }

        stage('Unit Tests Frontend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh """
                        npm ci
                        npm run test
                    """
                }
            }
        }
    }
}