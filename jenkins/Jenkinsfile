pipeline {
    agent any

    stages {
        stage('Unit Tests Backend') {
            agent {
                docker {
                    image 'golang:1.21-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-backend') {
                   sh """
                       apk add --no-cache git
                       go install gotest.tools/gotestsum@latest
                       GOCACHE=/tmp/go-build-cache gotestsum --junitfile junit-backend.xml --format standard-verbose -- ./...
                   """
                }
            }
        }

        stage('Unit Tests Frontend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh """
                        npm ci
                        npm run test
                    """
                }
            }
        }
    }

    post {
        always {
            junit 'bugtracker-backend/junit-backend.xml'
            junit 'bugtracker-frontend/test-results.xml'
        }
    }
}